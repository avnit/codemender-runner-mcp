# =============================================================================
# CodeMender Workload Identity Federation (WIF) & GitHub Configuration
# Governing: SPEC-WIF, REQ-0001, REQ-0002, REQ-0005, REQ-0006
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Cloud Project Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# The GCP Project ID hosting Vertex AI (local mode) or Cloud Run Jobs (cloud_run mode).
gcp_project_id = "your-gcp-project-id"

# The GCP region for resource deployment (default: "global"; set to e.g. "us-central1"
# when execution_mode = "cloud_run" to populate the GCP_REGION GitHub repository variable).
gcp_region = "global"


# -----------------------------------------------------------------------------
# 2. Execution Mode & Cloud Run Composition (OPTIONAL - Defaults to "local")
# -----------------------------------------------------------------------------
# Controls how GitHub Actions executes CodeMender and which least-privilege GCP IAM
# bindings and GitHub repository variables are provisioned:
#   - "local"     : Runs cm-runner directly on the GitHub Actions runner with Vertex AI access (default)
#   - "cloud_run" : Stages repository snapshots to a GCS transit bucket and invokes a Cloud Run Job
execution_mode = "local"

# When execution_mode = "cloud_run", pass the outputs from `terraform/gcp`:
#
# execution_mode          = "cloud_run"
# gcp_region              = "us-central1" # Matches `region` output from terraform/gcp
# gcs_transit_bucket_name = "your-gcp-project-id-codemender-reports" # `reports_bucket_name` output from terraform/gcp (REQUIRED in cloud_run mode)
# cloud_run_job_name      = "codemender-runner"                      # `runner_job_name` output from terraform/gcp
# cloud_run_runtime_sa_emails = [
#   "codemender-runner-sa@your-gcp-project-id.iam.gserviceaccount.com", # `runner_service_account_email` output from terraform/gcp
#   "codemender-worker-sa@your-gcp-project-id.iam.gserviceaccount.com", # `worker_service_account_email` output from terraform/gcp
# ]


# -----------------------------------------------------------------------------
# 3. GitHub Organization / User Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# GitHub organization name (e.g. "my-org") or username (e.g. "octocat").
github_owner = "your-github-org-or-username"

# Numeric App ID from Step 1.1 (GitHub App settings page, e.g. "123456").
# Configured automatically as the GH_APP_ID secret in target repositories.
github_app_id = "123456"


# -----------------------------------------------------------------------------
# 4. Workload Identity Federation (WIF) Scoping Type (REQUIRED)
# -----------------------------------------------------------------------------
# Controls who is authorized in GCP IAM to authenticate via WIF:
#   - "org"          : Authorizes ALL repositories under github_owner organization (Recommended for orgs)
#   - "user"         : Authorizes ALL repositories under github_owner user account (For personal accounts)
#   - "repositories" : Restricts GCP WIF access strictly to repositories listed in 'wif_allowed_repositories'
github_scope_type = "org"


# -----------------------------------------------------------------------------
# 5. Target GitHub Repositories for Actions Secrets, Variables & PR Label Setup
# -----------------------------------------------------------------------------
# List of repository names where Terraform will configure GitHub Secrets
# (GCP_WORKLOAD_IDENTITY_PROVIDER, GCP_SERVICE_ACCOUNT, GH_APP_ID), mode-specific
# GitHub Variables (GCS_TRANSIT_BUCKET, CLOUD_RUN_JOB_NAME, GCP_REGION in cloud_run mode),
# and the 'codemender-scan' PR trigger label.
#
# NOTE:
#   - When github_scope_type is "org" or "user": Set this list to the repos you are onboarding.
#   - When github_scope_type is "repositories": You can leave this empty ([]), and Terraform
#     will automatically use 'wif_allowed_repositories' below.
#
# Examples: ["backend-service", "frontend-app", "juice-shop-local"]
target_github_repositories = [
  "backend-service",
  "frontend-app"
]


# =============================================================================
# OPTIONAL ADVANCED CONFIGURATIONS (Uncomment if customizing)
# =============================================================================

# -----------------------------------------------------------------------------
# WIF Allowed Repositories (REQUIRED ONLY IF github_scope_type = "repositories")
# -----------------------------------------------------------------------------
# Defines the GCP IAM security perimeter (which repositories are allowed to
# authenticate with GCP via WIF). Must be formatted as "owner/repo".
# (Ignored when github_scope_type is "org" or "user").
#
# wif_allowed_repositories = [
#   "your-org/backend-service",
#   "your-org/frontend-app"
# ]

# Custom Service Account ID (default: "codemender-wif-sa")
# gcp_service_account_id = "codemender-wif-sa"

# Custom Workload Identity Pool ID (default: "codemender-wif-pool")
# gcp_wif_pool_id = "codemender-wif-pool"

# Custom Workload Identity Provider ID (default: "codemender-wif-provider")
# gcp_wif_provider_id = "codemender-wif-provider"
