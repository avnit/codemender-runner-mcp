set -euo pipefail

# 1. Pick Python interpreter: explicit override -> active local venv -> container fallback -> system python3
if [ -n "${CM_RUNNER_PYTHON:-}" ]; then
    PYTHON="${CM_RUNNER_PYTHON}"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "${VIRTUAL_ENV}/bin/python3" ]; then
    PYTHON="${VIRTUAL_ENV}/bin/python3"
elif [ -x "/opt/codemender/venv/bin/python3" ]; then
    PYTHON="/opt/codemender/venv/bin/python3"
else
    PYTHON="python3"
fi

# 2. Locate package directory and set PYTHONPATH
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")" && pwd)"
RUNNER_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${RUNNER_DIR}/.." && pwd)"
if [ -d "${RUNNER_DIR}/packages/codemender/src" ]; then
    PKG_SRC="${RUNNER_DIR}/packages/codemender/src"
elif [ -d "${REPO_ROOT}/packages/codemender/src" ]; then
    PKG_SRC="${REPO_ROOT}/packages/codemender/src"
elif [ -d "/opt/codemender/packages/codemender/src" ]; then
    PKG_SRC="/opt/codemender/packages/codemender/src"
else
    PKG_SRC=""
fi

if [ -n "${PKG_SRC}" ]; then
    export PYTHONPATH="${PKG_SRC}${PYTHONPATH:+:${PYTHONPATH}}"
fi

# 3. Dispatch to codemender.runner
exec "$PYTHON" -m codemender.runner "$@"
